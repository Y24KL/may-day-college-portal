# ─────────────────────────────────────────────────────────────
# May Day College Portal — environment variables
# Copy to .env for local development. NEVER commit real values.
# In production, set these in the Render dashboard.
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL — pooled connection (application)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mdc_dev"
# Neon PostgreSQL — direct (non-pooled) connection (migrations)
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mdc_dev"

# Public base URL of the app (used in emails, QR codes, links)
APP_BASE_URL="http://localhost:3000"

# Long random string used to sign tokens/hash secrets (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string"

# One-time token required by /setup to create the first Super Administrator.
# Remove/rotate it after setup. Setup is also disabled once any admin exists.
SETUP_TOKEN=""

# Shared secret that authorises scheduled job calls to /api/cron/* (GitHub Actions)
CRON_SECRET=""

# Resend (transactional email via HTTPS API)
RESEND_API_KEY=""
EMAIL_FROM="May Day College <no-reply@maydaycollege.com.ng>"
# Where operational alerts (backup failure, quota warnings) are sent
ADMIN_ALERT_EMAIL=""

# Cloudflare R2 (S3-compatible, private bucket)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="maydaycollege-files"
R2_ENDPOINT=""   # https://<account_id>.r2.cloudflarestorage.com

# Development only: when R2 is not configured and NODE_ENV != production,
# files are written to this private local directory (never served publicly).
LOCAL_STORAGE_DIR=".storage"
